#!/usr/bin/env python3
"""mem — CLI for the agent's long-term memory (memcore).

Examples
--------
  mem add -k preference -t "输出格式" -b "YG 要中文、直接给结果、不要前置说明" --tags style,lang --pin
  mem recall "上次插件清单是怎么整理的" --budget 900
  mem brief --budget 700 --save
  mem ingest                      # 灌入历史会话
  mem search "记忆系统" --kind decision --json
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from memcore import __version__, Memory, KIND_DEFAULTS, est_tokens  # noqa: E402


UI_TEMPLATE = os.path.join(HERE, "ui", "index.html")


def render_ui(data) -> str:
    with open(UI_TEMPLATE, "r", encoding="utf-8") as fh:
        tpl = fh.read()
    payload = json.dumps(data, ensure_ascii=False).replace("</", "<\\/")
    return tpl.replace("__DATA__", payload)


def parse_when(v):
    """Accept epoch seconds, YYYY-MM-DD, or 'YYYY-MM-DD HH:MM'."""
    if v in (None, ""):
        return None
    v = str(v).strip()
    if v.isdigit():
        return int(v)
    import datetime
    for fmt in ("%Y-%m-%d %H:%M", "%Y-%m-%d", "%Y/%m/%d", "%m-%d"):
        try:
            dt = datetime.datetime.strptime(v, fmt)
            if fmt == "%m-%d":
                dt = dt.replace(year=datetime.date.today().year)
            return int(dt.timestamp())
        except ValueError:
            continue
    raise SystemExit("bad date: %s (use YYYY-MM-DD or epoch)" % v)


def fmt_bytes_local(n) -> str:
    n = int(n or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0
    return "%d B" % n


def out(s: str = "") -> None:
    sys.stdout.write(s + "\n")


def dump(obj) -> None:
    out(json.dumps(obj, ensure_ascii=False, indent=2))


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(prog="mem", description="agent long-term memory")
    ap.add_argument("--home", default=None, help="memory home (default ~/.dsh/memory)")
    ap.add_argument("--version", action="version", version="memcore " + __version__)
    ap.add_argument("--json", action="store_true", help="JSON output")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="JSON output (also accepted after the subcommand)")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("add", parents=[common], help="write a memory")
    p.add_argument("-b", "--body", required=True)
    p.add_argument("-t", "--title", default="")
    p.add_argument("-k", "--kind", default="note", choices=sorted(KIND_DEFAULTS))
    p.add_argument("--tags", default="")
    p.add_argument("-p", "--project", default="")
    p.add_argument("--source", default="manual")
    p.add_argument("--source-ref", default="")
    p.add_argument("--salience", type=float, default=None)
    p.add_argument("--confidence", type=float, default=0.7)
    p.add_argument("--pin", action="store_true")
    p.add_argument("--ttl-days", type=int, default=0)
    p.add_argument("--no-dedupe", action="store_true")
    p.add_argument("--trigger", default="",
                   help="显式触发词（逗号分隔）：查询里出现就唤醒这条记忆")
    p.add_argument("--event-at", default=None,
                   help="事实发生的时间（YYYY-MM-DD 或 epoch）；不传=写入时间")

    for name in ("search", "s"):
        p = sub.add_parser(name, help="ranked search")
        p.add_argument("query")
        p.add_argument("-n", "--limit", type=int, default=10)
        p.add_argument("-p", "--project", default="")
        p.add_argument("-k", "--kind", action="append", default=[])
        p.add_argument("--tags", default="")
        p.add_argument("--min-score", type=float, default=0.0)
        p.add_argument("--as-of", default=None, help="YYYY-MM-DD 或 epoch：回到该时点的有效记忆")

    for name in ("recall", "r"):
        p = sub.add_parser(name, help="budget-packed context for a query")
        p.add_argument("query")
        p.add_argument("--budget", type=int, default=900)
        p.add_argument("-p", "--project", default="")
        p.add_argument("-k", "--kind", action="append", default=[])
        p.add_argument("--compact", action="store_true")
        p.add_argument("--as-of", default=None)

    p = sub.add_parser("brief", parents=[common], help="session-start capsule")
    p.add_argument("--budget", type=int, default=800)
    p.add_argument("-p", "--project", default="")
    p.add_argument("--save", action="store_true")

    p = sub.add_parser("get", parents=[common], help="show one memory")
    p.add_argument("id")

    p = sub.add_parser("update", parents=[common], help="edit fields")
    p.add_argument("id")
    p.add_argument("-t", "--title")
    p.add_argument("-b", "--body")
    p.add_argument("-k", "--kind")
    p.add_argument("--tags")
    p.add_argument("-p", "--project")
    p.add_argument("--salience", type=float)
    p.add_argument("--pin", dest="pinned", action="store_true")
    p.add_argument("--unpin", dest="pinned", action="store_false")
    p.add_argument("--trigger", help="显式触发词（逗号分隔），传空串表示清空")

    p = sub.add_parser("edit", parents=[common],
                       help="定点改记忆正文（old 必须逐字且唯一，仿 Letta memory_replace）")
    p.add_argument("id")
    p.add_argument("--old", required=True, help="要替换的原文片段（逐字）")
    p.add_argument("--new", required=True, help="替换成什么")
    p.add_argument("--all", action="store_true", help="允许 old 出现多次并全部替换")

    p = sub.add_parser("forget", parents=[common], help="delete one memory")
    p.add_argument("id")

    p = sub.add_parser("link", parents=[common], help="connect two memories")
    p.add_argument("src")
    p.add_argument("dst")
    p.add_argument("--rel", default="related")
    p.add_argument("--weight", type=float, default=1.0)

    p = sub.add_parser("retire", parents=[common], help="close a memory's validity window")
    p.add_argument("id")
    p.add_argument("--by", default=None, help="id of the newer memory that supersedes it")
    p.add_argument("--reason", default="")

    p = sub.add_parser("history", parents=[common], help="supersedes chain around one memory")
    p.add_argument("id")
    p.add_argument("--as-of", default=None, help="回到某个时点：取那一刻有效的那一版")

    p = sub.add_parser("relink", parents=[common], help="rebuild semantic related-edges")
    p.add_argument("--limit", type=int, default=4000)

    p = sub.add_parser("consolidate", parents=[common], help="find/merge duplicate & conflicting memories")
    p.add_argument("--full", action="store_true", help="全量体检（默认只查上次体检之后变过的条目）")
    p.add_argument("--retire", action="store_true",
                   help="with --apply, also close the older entry's validity window "
                        "(default: merge text only, never retire)")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--llm", action="store_true", help="use MEM_LLM_* endpoint to adjudicate")
    p.add_argument("--limit", type=int, default=400)

    p = sub.add_parser("ui", parents=[common], help="render a standalone Obsidian-style graph page")
    p.add_argument("--out", default=None)
    p.add_argument("--project", default="")
    p.add_argument("--limit", type=int, default=700)

    p = sub.add_parser("serve", parents=[common], help="live graph UI + JSON API on 127.0.0.1")
    p.add_argument("--port", type=int, default=8787)
    p.add_argument("--open", action="store_true")

    p = sub.add_parser("graph", parents=[common], help="neighbourhood of a memory")
    p.add_argument("id")
    p.add_argument("--depth", type=int, default=1)
    p.add_argument("--as-of", default=None, help="只显示那一刻仍然成立的边")

    p = sub.add_parser("wake", parents=[common], help="叫醒一条沉睡的记忆（唤醒权重 +1）")
    p.add_argument("id")
    p.add_argument("--reason", default="manual")

    p = sub.add_parser("sleep", parents=[common], help="让它沉睡（内容保留，强线索仍可唤回）")
    p.add_argument("id")
    p.add_argument("--reason", default="manual")

    p = sub.add_parser("unsleep", parents=[common], help="撤销人工沉睡，交还给时间与权重")
    p.add_argument("id")

    p = sub.add_parser("files", parents=[common], help="本机文件索引：登记目录 / 建索引 / 搜文件 / 打开")
    p.add_argument("action", choices=["add", "rm", "list", "index", "search", "status", "open"])
    p.add_argument("value", nargs="?", default="", help="目录路径（add/rm/open）或关键词（search）")
    p.add_argument("--mode", default="all", choices=["all", "name", "content"])
    p.add_argument("--ext", default="")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("--offset", type=int, default=0)
    p.add_argument("--full", action="store_true", help="index 时做全量重扫（默认增量）")
    p.add_argument("--reveal", action="store_true", help="open 时在文件管理器中选中该文件")

    p = sub.add_parser("preflight", parents=[common],
                       help="动手前查一次：这些文件/这个主题以前踩过什么坑")
    p.add_argument("paths", nargs="*", default=[], help="文件或目录（可多个）")
    p.add_argument("--topic", default="", help="没有具体文件时给个主题词")
    p.add_argument("-n", "--limit", type=int, default=10)
    p.add_argument("--budget", type=int, default=900)

    p = sub.add_parser("learn", parents=[common],
                       help="把刚踩的坑写回记忆（自动带 pitfall + 文件名标签）")
    p.add_argument("--file", default="", help="出事的文件/目录（坑按它归档）")
    p.add_argument("-t", "--title", required=True, help="一句话说清这个坑")
    p.add_argument("--what", default="", help="现象：怎么发现的 / 表现是什么")
    p.add_argument("--fix", default="", help="修法：下次直接照着做")
    p.add_argument("--tags", default="", help="额外标签（逗号分隔）")

    p = sub.add_parser("states", parents=[common], help="状态分布 / 沉睡区清单")
    p.add_argument("--state", default="", help="只列某一档：fuzzy|dormant|deep")
    p.add_argument("-n", "--limit", type=int, default=30)

    p = sub.add_parser("timeline", parents=[common], help="recent activity")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("-p", "--project", default="")
    p.add_argument("-n", "--limit", type=int, default=40)

    p = sub.add_parser("ingest", parents=[common], help="import dsh session archives")
    p.add_argument("--root", default=None)
    p.add_argument("--limit", type=int, default=0)
    p.add_argument("-p", "--project", default="")
    p.add_argument("--force", action="store_true", help="re-import even if unchanged")

    p = sub.add_parser("export", parents=[common], help="render Markdown index / JSONL")
    p.add_argument("--path", default=None)
    p.add_argument("--jsonl", default=None)

    sub.add_parser("maintain", parents=[common], help="ingest + relink + gc + export（一条命令做完日常维护）")
    sub.add_parser("stats", parents=[common], help="counts and size")
    sub.add_parser("reindex", parents=[common], help="rebuild FTS + vectors")
    p = sub.add_parser("gc", parents=[common], help="drop expired/cold items")
    p.add_argument("--dry-run", action="store_true")
    sub.add_parser("doctor", parents=[common], help="self-check")

    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help()
        return 2

    m = Memory(args.home)
    try:
        if args.cmd == "add":
            tags = [t for t in args.tags.split(",") if t.strip()]
            meta = {}
            if args.trigger:
                meta["triggers"] = [t.strip() for t in args.trigger.split(",") if t.strip()]
            r = m.add(args.body, title=args.title, kind=args.kind, tags=tags, project=args.project,
                      source=args.source, source_ref=args.source_ref, salience=args.salience,
                      confidence=args.confidence, pinned=args.pin, ttl_days=args.ttl_days,
                      dedupe=not args.no_dedupe, meta=meta,
                      event_at=parse_when(args.event_at))
            m.export_markdown()
            if args.json:
                dump(r)
            else:
                tail = " (deduped:%s)" % r["deduped"] if r.get("deduped") else ""
                out("%s %s%s" % (r["id"], (args.title or args.body)[:60], tail))
            return 0

        if args.cmd in ("search", "s"):
            hits = m.search(args.query, limit=args.limit, project=args.project,
                            kinds=args.kind, tags=[t for t in args.tags.split(",") if t],
                            min_score=args.min_score, as_of=parse_when(args.as_of))
            if args.json:
                dump(hits)
            else:
                if not hits:
                    out("(no hits)")
                for h in hits:
                    mark = "" if h.get("state", "awake") == "awake" else "〔%s〕" % h.get(
                        "state_label", h.get("state"))
                    woke = "·已唤醒" if h.get("woke") else ""
                    out("%s%s%s  %.3f  lex=%.2f sem=%.2f  %s  %s  %s" % (
                        h["id"], mark, woke, h["score"], h["lexical"], h["semantic"], h["kind"],
                        h["project"] or "-", h["title"]))
            return 0

        if args.cmd in ("recall", "r"):
            r = m.recall(args.query, budget_tokens=args.budget, project=args.project,
                         kinds=args.kind, compact=args.compact, as_of=parse_when(args.as_of))
            if args.json:
                dump(r)
            else:
                out(r["text"])
            return 0

        if args.cmd == "brief":
            txt = m.brief(budget_tokens=args.budget, project=args.project)
            if args.save:
                path = os.path.join(m.home, "BRIEF.md")
                with open(path, "w", encoding="utf-8") as fh:
                    fh.write(txt)
                if not args.json:
                    out("saved %s" % path)
            if args.json:
                dump({"text": txt, "tokens": est_tokens(txt)})
            elif not args.save:
                out(txt)
            return 0

        if args.cmd == "get":
            r = m.get(args.id)
            if not r:
                out("not found: %s" % args.id)
                return 1
            if args.json:
                dump(r)
            else:
                out("%s  [%s/%s]  %s" % (r["id"], r["kind"], r["project"] or "-",
                                         time.strftime("%Y-%m-%d %H:%M", time.localtime(r["created_at"]))))
                out("title: %s" % r["title"])
                out("tags : %s" % r["tags"])
                out("meta : salience=%.2f conf=%.2f pinned=%s uses=%d src=%s" % (
                    r["salience"], r["confidence"], bool(r["pinned"]), r["use_count"], r["source"]))
                st = m.memory_state(r)
                wake_txt = ("唤醒 %d 次" % st["wake_count"]) if st["wake_count"] else "从未唤醒"
                last = ("%.1f 天前" % ((time.time() - st["last_wake_at"]) / 86400)) \
                    if st["last_wake_at"] else "从未"
                out("state: %s  激活度 %.2f  记忆龄 %.1f 天 / 保质期 %.1f 天 · %s · 最近唤醒 %s" % (
                    st["state_label"], st["activation"], st["age_days"], st["halflife_days"],
                    wake_txt, last))
                cues = m.memory_triggers(r)
                if cues:
                    out("暗号: %s（查询里出现就会唤醒它）" % "、".join(cues))
                if st["state"] != "awake":
                    # 显式翻看 = 一次注意：记忆被点亮，正文才是完整的
                    m.wake(args.id, "manual")
                    out("（这条记忆原处于「%s」，你翻开了它 —— 已唤醒）" % st["state_label"])
                out("-" * 60)
                out(r["body"])
            return 0

        if args.cmd == "update":
            fields = {}
            for k in ("title", "body", "kind", "project", "salience"):
                v = getattr(args, k, None)
                if v is not None:
                    fields[k] = v
            if args.tags is not None:
                fields["tags"] = [t for t in args.tags.split(",") if t]
            if args.pinned is not None:
                fields["pinned"] = args.pinned
            if args.trigger is not None:
                fields["meta"] = {"triggers": [t.strip() for t in args.trigger.split(",") if t.strip()]}
            ok = m.update(args.id, **fields)
            m.export_markdown()
            out("updated" if ok else "no-op")
            return 0 if ok else 1

        if args.cmd == "edit":
            r = m.replace_in_body(args.id, args.old, args.new, replace_all=args.all)
            if args.json:
                dump(r)
            elif r["ok"]:
                out("已定点替换 %d 处" % r["replaced"])
            else:
                out("改不动：%s%s" % (r["error"],
                                     ("（第 %s 行都有）" % r["lines"]) if r.get("lines") else ""))
            return 0 if r["ok"] else 1

        if args.cmd == "forget":
            ok = m.forget(args.id)
            m.export_markdown()
            out("forgotten" if ok else "not found")
            return 0 if ok else 1

        if args.cmd == "link":
            ok = m.link(args.src, args.dst, args.rel, args.weight)
            out("linked" if ok else "missing endpoint")
            return 0 if ok else 1

        if args.cmd == "retire":
            ok = m.retire(args.id, by=args.by, reason=args.reason)
            m.export_markdown()
            out("retired" if ok else "not found")
            return 0 if ok else 1

        if args.cmd == "history":
            h = m.history(args.id, as_of=parse_when(args.as_of))
            if h.get("as_of"):
                pick = h.get("at")
                out("时点 %s 的版本：%s" % (time.strftime("%Y-%m-%d", time.localtime(h["as_of"])),
                                           ("%s %s" % (pick["id"], pick["title"][:50])) if pick else "(该时点无记录)"))
            for r in h["chain"]:
                mark = "●" if r["id"] == args.id else "○"
                out("%s %s  %s  %s  %s" % (mark, r["id"],
                    time.strftime("%m-%d %H:%M", time.localtime(r["created_at"])),
                    r["status"], r["title"][:60]))
            return 0

        if args.cmd == "relink":
            n = m.relink(limit=args.limit)
            out("related edges: %d" % n)
            return 0

        if args.cmd == "consolidate":
            if args.retire:
                m.cfg.setdefault("consolidate", {})["auto_retire"] = True
            rep = m.consolidate(dry_run=not args.apply, llm=args.llm, limit=args.limit,
                                incremental=not args.full)
            if args.json:
                dump(rep)
            else:
                for r in rep:
                    out("%-7s %.3f  %s ~ %s  %s" % (r["action"], r["sim"], r["a"], r["b"],
                                                     " / ".join(r["titles"])[:80]))
                out("%d candidate pair(s), %s" % (len(rep), "applied" if args.apply else "dry-run"))
            if args.apply:
                m.export_markdown()
            return 0

        if args.cmd == "ui":
            data = m.graph_export(project=args.project, limit=args.limit)
            path = args.out or os.path.join(m.home, "graph.html")
            html = render_ui(data)
            with open(path, "w", encoding="utf-8") as fh:
                fh.write(html)
            out("wrote %s (%d nodes, %d edges)" % (path, len(data["nodes"]), len(data["edges"])))
            return 0

        if args.cmd == "serve":
            from server import serve
            serve(m, port=args.port, open_browser=args.open)
            return 0

        if args.cmd == "graph":
            g = m.graph(args.id, args.depth, as_of=parse_when(args.as_of))
            if args.json:
                dump(g)
            else:
                for n in g["nodes"]:
                    out("%s%s [%s] %s" % ("  " * n["depth"], n["id"], n["kind"], n["title"]))
                for e in g["edges"]:
                    out("  %s -%s-> %s (%.1f)" % (e["src"], e["rel"], e["dst"], e["w"]))
            return 0

        if args.cmd in ("wake", "sleep", "unsleep"):
            fn = {"wake": m.wake, "sleep": m.sleep, "unsleep": m.unsleep}[args.cmd]
            st = fn(args.id, getattr(args, "reason", "manual")) if args.cmd != "unsleep" \
                else fn(args.id)
            if not st:
                out("not found: %s" % args.id)
                return 1
            if args.json:
                dump(st)
            else:
                out("%s \u2192 %s（激活度 %.2f）" % (args.id, st["state_label"], st["activation"]))
            return 0

        if args.cmd == "files":
            act = args.action
            if act in ("add", "rm"):
                if not args.value:
                    out("用法：mem files %s <目录>" % act)
                    return 2
                r = m.add_file_root(args.value) if act == "add" else m.remove_file_root(args.value)
                if args.json:
                    dump(r)
                else:
                    out(("已登记：" if act == "add" else "已移除：") + args.value if r.get("ok") else r.get("error", "失败"))
                    for x in (r.get("roots") or []):
                        out("  - " + x)
                return 0 if r.get("ok") else 1
            if act == "list":
                roots = m.file_roots()
                if args.json:
                    dump({"roots": roots})
                else:
                    out("\n".join(roots) if roots else "(还没有登记目录：mem files add <dir>)")
                return 0
            if act == "index":
                r = m.index_files(incremental=not args.full)
                if args.json:
                    dump(r)
                else:
                    if not r.get("ok"):
                        out(r.get("error", "索引失败")); return 1
                    out("索引完成：更新 %d · 跳过 %d · 清理 %d · 共 %d 个文件"
                        % (r["updated"], r["skipped"], r["removed"], r["files"]))
                return 0
            if act == "status":
                st = m.file_status()
                if args.json:
                    dump(st)
                else:
                    out("目录 %d 个 · 文件 %d 个 · 有正文 %d 个" % (len(st["roots"]), st["files"], st["content_indexed"]))
                    for x in st["roots"]:
                        out("  - " + x)
                    li = st.get("last_index") or {}
                    if li:
                        out("上次索引：%s · 更新 %d · 跳过 %d" % (
                            time.strftime("%Y-%m-%d %H:%M", time.localtime(int(li.get("at", 0)))),
                            li.get("updated", 0), li.get("skipped", 0)))
                return 0
            if act == "search":
                r = m.file_search(args.value, mode=args.mode, limit=args.limit,
                                  offset=args.offset, ext=args.ext)
                if args.json:
                    dump(r)
                else:
                    if not r["results"]:
                        out("(没有命中；先 mem files index 建索引，或 mem files add <dir> 登记目录)")
                    for x in r["results"]:
                        out("%s %-40s %s%s" % ("[正文]" if x["hit"] == "content" else "[名字]",
                                               x["path"], fmt_bytes_local(x["size"]),
                                               ("\n      " + x["snippet"][:120]) if x.get("snippet") else ""))
                    out("共 %d 条" % r["total"])
                return 0
            if act == "open":
                r = m.open_path(args.value, reveal=args.reveal)
                if args.json:
                    dump(r)
                else:
                    out(("已在文件管理器中打开：" if r.get("ok") else r.get("error", "打开失败")) + (r.get("opened") or ""))
                return 0 if r.get("ok") else 1
            return 2

        if args.cmd == "preflight":
            r = m.preflight(args.paths, topic=args.topic, limit=args.limit,
                            budget_tokens=args.budget)
            if args.json:
                dump(r)
            else:
                out(r["text"])
            return 0

        if args.cmd == "learn":
            keys = m._path_keys([args.file] if args.file else [])
            tags = ["pitfall"] + keys + [t.strip().lower() for t in args.tags.split(",") if t.strip()]
            body = []
            if args.what:
                body.append("现象：" + args.what.strip())
            if args.fix:
                body.append("修法：" + args.fix.strip())
            if not body:
                body.append("现象：(未填)　修法：(未填)")
            r = m.add("\n".join(body), title=args.title.strip(), kind="insight",
                      tags=list(dict.fromkeys(tags)), salience=0.9, source="learn")
            m.export_markdown()
            if args.json:
                dump({"id": r["id"], "tags": tags, "deduped": r.get("deduped")})
            else:
                out("%s 已记为雷区%s" % (r["id"], "（同一条已存在，已强化）" if r.get("deduped") else ""))
            return 0

        if args.cmd == "states":
            counts = m.state_counts()
            if not args.state:
                rows = m.sleepers(limit=args.limit)
            else:
                rows = [r for r in m.sleepers(limit=1000) if r["state"] == args.state][: args.limit]
            if args.json:
                dump({"counts": counts, "items": rows})
            else:
                out("清醒 %d · 模糊 %d · 沉睡 %d · 深度沉睡 %d"
                    % (counts["awake"], counts["fuzzy"], counts["dormant"], counts["deep"]))
                for r in rows:
                    nxt = ("%.1f 天后掉档" % r["next_state_in_days"]) \
                        if r["next_state_in_days"] is not None else "已到底/被钉住"
                    quiet = r.get("since_touch_days", r["age_days"])
                    cues = ("  暗号:" + ",".join(r["triggers"])) if r.get("triggers") else ""
                    out("%s  %-4s 激活 %.2f  龄 %.1f 天 / %.1f 天没想起  %s  唤醒 %d 次  %s%s"
                        % (r["id"], r["state_label"], r["activation"], r["age_days"], quiet, nxt,
                           r["wake_count"], r["title"][:36], cues))
                if rows:
                    out("叫醒：mem wake <ID>")
            return 0

        if args.cmd == "timeline":
            for r in m.timeline(args.days, args.project, args.limit):
                out("%s  %s  %-9s %-18s %s" % (
                    time.strftime("%m-%d %H:%M", time.localtime(r["created_at"])),
                    r["id"], r["kind"], (r["project"] or "-")[:18], r["title"][:60]))
            return 0

        if args.cmd == "ingest":
            r = m.ingest_sessions(args.root, args.limit, args.project, force=args.force)
            m.export_markdown()
            dump(r) if args.json else out("sessions=%d added=%d %s" % (
                r.get("sessions", 0), r.get("added", 0), r.get("note", "")))
            return 0

        if args.cmd == "export":
            p = m.export_markdown(args.path)
            extra = ""
            if args.jsonl:
                n = m.export_jsonl(args.jsonl)
                extra = " + %d jsonl" % n
            out("wrote %s%s" % (p, extra))
            return 0

        if args.cmd == "maintain":
            r = m.maintain()
            if args.json:
                dump(r)
            else:
                out("ingest=%d added=%d | related edges +%d | gc -%d | total %d"
                    % (r["ingest"].get("sessions", 0), r["ingest"].get("added", 0),
                       r["new_edges"], r["gc"], r["total"]))
            return 0

        if args.cmd == "stats":
            dump(m.stats())
            return 0

        if args.cmd == "reindex":
            n = m.reindex()
            out("reindexed %d" % n)
            return 0

        if args.cmd == "gc":
            dump(m.gc(dry_run=args.dry_run))
            return 0

        if args.cmd == "doctor":
            problems = []
            try:
                m.db.execute("SELECT count(*) FROM mem_fts").fetchone()
            except Exception as e:
                problems.append("fts: %s" % e)
            n_vec = m.db.execute("SELECT count(*) c FROM vectors").fetchone()["c"]
            n_mem = m.db.execute("SELECT count(*) c FROM memories").fetchone()["c"]
            if n_vec != n_mem:
                problems.append("vectors %d != memories %d (run: mem reindex)" % (n_vec, n_mem))
            probe = m.search("测试 probe", limit=1)
            dump({"home": m.home, "memories": n_mem, "vectors": n_vec,
                  "fts": "ok", "search_ok": True, "problems": problems})
            return 0

        ap.print_help()
        return 2
    finally:
        m.close()


if __name__ == "__main__":
    raise SystemExit(main())
